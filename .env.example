# =============================================================================
# Parental Control Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=parental_control

# Full database URL (used by backend and Prisma)
DATABASE_URL=postgresql://postgres:your_strong_postgres_password_here@localhost:5432/parental_control

# -----------------------------------------------------------------------------
# Backend - General
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Backend - Authentication (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Backend - CORS
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# Backend - Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Backend - Email / SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@parentalcontrol.com

# -----------------------------------------------------------------------------
# Backend - External APIs
# -----------------------------------------------------------------------------
# Google Maps API Key (for location services)
GOOGLE_API_KEY=your_google_api_key_here

# Firebase Cloud Messaging (for push notifications to Android app)
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_PROJECT_ID=your_firebase_project_id_here

# -----------------------------------------------------------------------------
# Dashboard (React/Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=Parental Control Dashboard

# -----------------------------------------------------------------------------
# Nginx / SSL
# -----------------------------------------------------------------------------
# Domain name for SSL certificate generation
DOMAIN=localhost
SSL_EMAIL=admin@yourdomain.com

# -----------------------------------------------------------------------------
# Android App
# -----------------------------------------------------------------------------
# Backend URL the Android app connects to
ANDROID_API_BASE_URL=http://10.0.2.2:3000/api
# API key for device registration
DEVICE_API_KEY=your_device_api_key_here

# -----------------------------------------------------------------------------
# Production Only (optional overrides)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:prod_password@db-host:5432/parental_control_production
# JWT_SECRET=production_jwt_secret_minimum_32_chars
# JWT_REFRESH_SECRET=production_refresh_secret_minimum_32_chars
# CORS_ORIGIN=https://yourdomain.com
